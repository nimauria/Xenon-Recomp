{
  "name": "xenon-launcher-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "\u003e=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit \u0026\u0026 vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "cef:fetch": "node scripts/fetch-cef.mjs",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -BuildOnly",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
