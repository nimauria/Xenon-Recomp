cmake_minimum_required(VERSION 3.25)
get_filename_component(launcher_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BUILD_ROOT)
  set(BUILD_ROOT "${launcher_root}/build/native")
endif()
file(READ "${BUILD_ROOT}/launcher-build.json" build_info)
string(JSON platform GET "${build_info}" platform)
string(JSON version GET "${build_info}" version)
if(NOT platform MATCHES "^(linux|macos)-(x64|arm64)$")
  message(FATAL_ERROR "Expected a Linux or macOS desktop build")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef package_id)
set(source "${BUILD_ROOT}/desktop")
set(output "${launcher_root}/build/packages/${package_id}")
set(payload "${output}/payload")
if(DEFINED STAGED_PAYLOAD)
  file(REAL_PATH "${launcher_root}/build/packages" staging_root)
  file(REAL_PATH "${STAGED_PAYLOAD}" staged)
  cmake_path(IS_PREFIX staging_root "${staged}" NORMALIZE owned)
  if(NOT owned)
    message(FATAL_ERROR "Only an owned package staging folder can be re-archived")
  endif()
  file(READ "${staged}/launcher-package.json" staged_info)
  string(JSON staged_product GET "${staged_info}" product)
  string(JSON staged_platform GET "${staged_info}" platform)
  string(JSON staged_version GET "${staged_info}" version)
  if(NOT staged_product STREQUAL "xenon-launcher-next" OR NOT staged_platform STREQUAL platform OR NOT staged_version STREQUAL version)
    message(FATAL_ERROR "Staged package identity does not match this build")
  endif()
  set(payload "${staged}")
  set(source "${staged}")
endif()
file(MAKE_DIRECTORY "${payload}" "${output}")
if(platform MATCHES "^macos-")
  set(entries XenonLauncher.app)
else()
  set(entries xenon_launcher_next xenon_launcher_updater libcef.so chrome-sandbox
    libvk_swiftshader.so libvulkan.so.1 vk_swiftshader_icd.json chrome_100_percent.pak
    chrome_200_percent.pak icudtl.dat resources.pak v8_context_snapshot.bin
    settings-schema.json module-catalog-fallback.json CEF-LICENSE.txt web locales licenses)
  foreach(optional libminigbm.so extensions)
    if(EXISTS "${source}/${optional}")
      list(APPEND entries "${optional}")
    endif()
  endforeach()
endif()
foreach(entry IN LISTS entries)
  if(NOT EXISTS "${source}/${entry}")
    message(FATAL_ERROR "Missing package input: ${entry}")
  endif()
  file(GLOB_RECURSE inputs LIST_DIRECTORIES true "${source}/${entry}/*")
  list(APPEND inputs "${source}/${entry}")
  foreach(input IN LISTS inputs)
    if(IS_SYMLINK "${input}")
      file(REAL_PATH "${input}" resolved)
      cmake_path(IS_PREFIX source "${resolved}" NORMALIZE within_source)
      if(NOT within_source)
        message(FATAL_ERROR "Package link escapes the build: ${input}")
      endif()
    endif()
  endforeach()
  if(NOT DEFINED STAGED_PAYLOAD)
    file(COPY "${source}/${entry}" DESTINATION "${payload}")
  endif()
endforeach()
file(WRITE "${payload}/launcher-package.json" "{\"product\":\"xenon-launcher-next\",\"format\":1,\"stateSchema\":1,\"version\":\"${version}\",\"platform\":\"${platform}\"}\n")
if(platform MATCHES "^linux-")
  file(CHMOD_RECURSE "${payload}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
    DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(CHMOD "${payload}/xenon_launcher_next" "${payload}/xenon_launcher_updater" "${payload}/chrome-sandbox"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
set(archive "${output}/xenon-launcher-next-${platform}.tar.gz")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${archive}" --format=gnutar .
  WORKING_DIRECTORY "${payload}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${archive}" digest)
file(WRITE "${archive}.sha256" "${digest}  xenon-launcher-next-${platform}.tar.gz\n")
message(STATUS "Archive ${archive}")
message(STATUS "SHA256 ${digest}")
message(STATUS "Payload ${payload}")
