# Build directories
build/
Build/
build-*/
out/

# Gen 10 content-addressed codegen cache
generated/

# Ninja
*.ninja_log
.ninja_deps

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Compiled object files
*.slo
*.lo
*.o
*.obj
.txt

# Precompiled headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger files
*.pdb
*.dwo

# Compiled static libraries
*.a
*.la
*.lai
*.lib

# Compiled dynamic libraries
*.dll
*.dylib
*.so
*.so.*

# Executables
*.app
*.exe
*.out

# Fortran module files
*.mod
*.smod

# Prerequisites
*.d

# Temporary files
*.bak
*.log
*.swp
*.swo
*~
*.orig
*.tmp

# Crash dumps
*.dmp
*.stackdump

# Coverage output
*.gcda
*.gcno
*.gcov
coverage/
!/tools/coverage/
!/docs/coverage/

# Test output & cache
.cache/
Testing/

# Xenon managed dependency/cache state
.xenon/

# vcpkg
vcpkg_installed/

# Local editor / tooling
.vscode/
.vs/
.idea/
*.user
*.suo
CMakeUserPresets.json

# Python build artifacts (tools/deps, tools/release helper scripts)
__pycache__/
*.pyc

# OS-generated files
Thumbs.db
desktop.ini
.DS_Store

# Local secrets/environment
.env
.env.*

# Code-signing material (installer/release signing) - never commit private keys
*.pfx
*.p12
*.pem
*.key

# User-supplied Xbox 360 content - Xenon does not distribute or version any of
# this; keeps a locally imported/tested game from ever being committed by accident
*.xex
*.iso
*.stfs
*.xcontent

# Local Claude Code instructions
CLAUDE.md
.claude/

# Xenon-owned prebuilt dependencies that are intentionally versioned
!third_party/xenon-ffmpeg/
!third_party/xenon-ffmpeg/**
!third_party/xenon-ffmpeg/**/*.lib

# Design notes and trackers stay local and are not published. Only the
# documents README.md links to are tracked, plus the CI-generated coverage
# dashboard. A new document stays local unless it is listed here.
